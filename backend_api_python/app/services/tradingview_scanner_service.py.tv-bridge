"""
TradingView Scanner API - 获取大量加密货币数据
通过 tv-bridge (localhost:3456) 获取数据，替代直接 HTTP 连接 TradingView

迁移说明：
  原有版本直连 scanner.tradingview.com (HTTP)，在国内网络环境下不可用。
  新版本通过 tv-bridge (Node.js + SOCKS5 代理) 获取数据。

数据流:
  Python → http://localhost:3456/scan → tv-bridge → SOCKS5 → TradingView WS/REST

接口完全兼容旧版:
  - get_top_perpetuals(limit)
  - get_default_watchlist(limit)
  - get_top_gainers(limit)
  - get_crypto_data(symbols)
"""
import requests
import json
import os
from typing import List, Dict, Any
from app.utils.logger import get_logger

logger = get_logger(__name__)

TV_BRIDGE_URL = "http://localhost:3456"


class TradingViewScannerAPI:
    """通过 tv-bridge 获取 TradingView Scanner 数据"""

    def __init__(self):
        self.bridge_url = TV_BRIDGE_URL
        self.session = requests.Session()
        self.session.headers.update({
            'Content-Type': 'application/json',
            'Accept': 'application/json',
        })
        logger.info("📡 TradingViewScannerAPI 已切换到 tv-bridge 模式")

    def _call_bridge(self, endpoint: str, data: dict = None, timeout: int = 30) -> dict:
        """调用 tv-bridge API"""
        url = f"{self.bridge_url}/{endpoint}"
        try:
            if data:
                resp = self.session.post(url, json=data, timeout=timeout)
            else:
                resp = self.session.get(url, timeout=timeout)
            resp.raise_for_status()
            return resp.json()
        except requests.exceptions.ConnectionError:
            logger.error(f"❌ tv-bridge 不可用 ({self.bridge_url})")
            return {}
        except Exception as e:
            logger.error(f"❌ tv-bridge 调用失败: {e}")
            return {}

    def get_crypto_data(
        self,
        symbols: List[str],
        columns: List[str] = None
    ) -> List[Dict[str, Any]]:
        """
        获取加密货币数据

        Args:
            symbols: 币种列表, 如 ['BINANCE:BTCUSDT', 'BINANCE:ETHUSDT']
            columns: 要获取的字段列表

        Returns:
            币种数据列表
        """
        if columns is None:
            columns = ['close', 'volume', 'change', 'Perf.W']

        try:
            logger.info(f"📡 [tv-bridge] 获取 {len(symbols)} 个币种数据...")

            result = self._call_bridge("scan", {
                "symbols": symbols,
                "columns": columns
            }, timeout=max(30, len(symbols) * 2))

            if not result or "results" not in result:
                logger.warning("tv-bridge scan 返回空")
                return []

            return self._parse_scan_results(result["results"], columns)

        except Exception as e:
            logger.error(f"获取数据失败: {e}")
            return []

    def _parse_scan_results(self, results: list, columns: List[str]) -> List[Dict[str, Any]]:
        """解析 scan 返回结果，兼容旧格式"""
        parsed = []
        for item in results:
            try:
                symbol = item.get("symbol", "")
                values = item.get("values", {})
                clean_symbol = symbol.replace("BINANCE:", "") if "BINANCE:" in symbol else symbol

                parsed.append({
                    "symbol": clean_symbol,
                    "full_symbol": symbol,
                    "name": clean_symbol,
                    "description": clean_symbol,
                    "price": values.get("close", 0),
                    "change_percentage": values.get("change", 0),
                    "volume": values.get("volume", 0),
                    "exchange": "Binance",
                    "source": "tv-bridge",
                })
            except Exception as e:
                logger.debug(f"解析失败: {e}")
                continue
        return parsed

    def get_top_perpetuals(self, limit: int = 50) -> List[Dict[str, Any]]:
        """
        获取币安Top永续合约

        通过 tv-bridge 获取交易品种列表，然后批量获取数据
        """
        try:
            logger.info(f"📡 [tv-bridge] 获取永续合约 (limit={limit})...")

            # 先通过搜索获取所有 USDT 永续合约
            search_result = self._call_bridge(f"search?q=BINANCE:.P", timeout=15)
            markets = search_result.get("markets", [])

            if not markets:
                logger.warning("tv-bridge 搜索返回空")
                return []

            # 筛选 USDT 永续合约 (.P 后缀)
            perpetuals = [
                m["id"] for m in markets
                if m.get("type") == "swap" or m.get("id", "").endswith(".P")
            ]

            if not perpetuals:
                # 如果筛选不到，尝试用期货类型
                perpetuals = [
                    m["id"] for m in markets
                    if m.get("type") in ("swap", "futures")
                ]

            if not perpetuals:
                perpetuals = [m["id"] for m in markets]

            logger.info(f"✅ 筛选到 {len(perpetuals)} 个永续合约")

            # 限制数量
            perpetuals = perpetuals[:limit]

            if not perpetuals:
                return []

            # 批量获取数据
            return self._fetch_batch_data(perpetuals)

        except Exception as e:
            logger.error(f"获取永续合约失败: {e}")
            return []

    def _fetch_batch_data(self, tv_symbols: List[str]) -> List[Dict[str, Any]]:
        """批量获取数据"""
        batch_size = 30
        all_data = []

        logger.info(f"📡 分批获取 {len(tv_symbols)} 个币种数据...")

        for i in range(0, len(tv_symbols), batch_size):
            batch = tv_symbols[i:i + batch_size]
            try:
                batch_data = self.get_crypto_data(batch)
                if batch_data:
                    all_data.extend(batch_data)
            except Exception as e:
                logger.warning(f"批次 {i // batch_size + 1} 失败: {e}")

        logger.info(f"✅ 获取到 {len(all_data)}/{len(tv_symbols)} 个币种")
        return all_data

    def get_default_watchlist(self, limit: int = 20) -> List[Dict[str, Any]]:
        """获取默认关注列表"""
        default_symbols = [
            'BINANCE:BTCUSDT', 'BINANCE:ETHUSDT', 'BINANCE:BNBUSDT',
            'BINANCE:SOLUSDT', 'BINANCE:XRPUSDT', 'BINANCE:ADAUSDT',
            'BINANCE:DOGEUSDT', 'BINANCE:MATICUSDT', 'BINANCE:DOTUSDT',
            'BINANCE:AVAXUSDT', 'BINANCE:LINKUSDT', 'BINANCE:UNIUSDT',
            'BINANCE:LTCUSDT', 'BINANCE:ATOMUSDT', 'BINANCE:NEARUSDT',
            'BINANCE:APTUSDT', 'BINANCE:OPUSDT', 'BINANCE:ARBUSDT',
            'BINANCE:INJUSDT', 'BINANCE:QNTUSDT',
        ]
        symbols = default_symbols[:limit]
        logger.info(f"📡 获取默认关注列表 ({len(symbols)} 个)")
        return self.get_crypto_data(symbols)

    def get_top_gainers(self, limit: int = 20) -> List[Dict[str, Any]]:
        """获取涨幅榜"""
        all_coins = self.get_top_perpetuals(limit=600)
        if not all_coins:
            return []

        gainers = [c for c in all_coins if isinstance(c.get("change_percentage"), (int, float))]
        gainers.sort(key=lambda x: x.get("change_percentage", 0), reverse=True)

        result = gainers[:limit]

        # 记录涨幅榜统计
        try:
            from app.services.gainer_tracker import record_gainer_appearance
            gainer_data = []
            for i, coin in enumerate(result):
                gainer_data.append({
                    "symbol": coin["symbol"],
                    "price": coin.get("price"),
                    "change_percentage": coin.get("change_percentage"),
                    "volume": coin.get("volume"),
                    "rank": i + 1,
                })
            record_gainer_appearance(gainer_data)
        except Exception as e:
            logger.warning(f"记录涨幅榜统计失败: {e}")

        return result


# 便捷函数（兼容旧接口）
def get_tradingview_crypto_data(symbols: List[str]) -> List[Dict[str, Any]]:
    api = TradingViewScannerAPI()
    return api.get_crypto_data(symbols)


def get_top_perpetuals(limit: int = 50) -> List[Dict[str, Any]]:
    api = TradingViewScannerAPI()
    return api.get_top_perpetuals(limit)


def get_default_watchlist(limit: int = 20) -> List[Dict[str, Any]]:
    api = TradingViewScannerAPI()
    return api.get_default_watchlist(limit)


def get_top_gainers(limit: int = 20) -> List[Dict[str, Any]]:
    api = TradingViewScannerAPI()
    return api.get_top_gainers(limit)
